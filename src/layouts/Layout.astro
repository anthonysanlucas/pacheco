---
import '../styles/global.css';
import BackToTopButton from '../components/BackToTopButton.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'PACHECO | Comunicación con criterio',
	description = 'Acompañamos a autoridades, ejecutivos y organizaciones a plantear estrategias de comunicación con criterio para cada escenario.'
} = Astro.props;

const faviconSrc = '/PACHECO_BRAND_ISOTIPO.svg';
const ogImageSrc = '/BANNER_16_9.webp';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="author" content="PACHECO" />
		<meta name="theme-color" content="#fbfaf7" />
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_EC" />
		<meta property="og:site_name" content="PACHECO" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(ogImageSrc, Astro.url).href} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="675" />
		<meta property="og:url" content={Astro.url.href} />
		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(ogImageSrc, Astro.url).href} />
		<link rel="preload" href="/fonts/Helvetica-Bold.ttf" as="font" type="font/ttf" crossorigin />
		<link rel="icon" type="image/svg+xml" href={faviconSrc} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
		<BackToTopButton />
	</body>
</html>
