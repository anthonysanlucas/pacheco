---
import type { Identity } from '../data/site';

interface Props {
	identity: Identity;
}

const { identity } = Astro.props;
---

<section id="criterio" class="bg-ink py-24 text-paper md:py-32">
	<div class="page-shell">
		<div class="grid gap-14 md:grid-cols-12 md:items-start md:gap-8">
			<h2
				class="display-criterion m-0 min-w-0 uppercase md:col-span-7"
				aria-label="No todo necesita comunicación"
			>
				<span class="block" data-reveal>No todo</span>
				<span class="block" data-reveal>necesita</span>
				<span class="block text-[0.72em]" data-reveal>comunicación</span>
			</h2>

			<div class="min-w-0 md:col-span-4 md:col-start-9">
				<img
					class="aspect-[4/5] w-full object-cover object-center grayscale"
					src={identity.profileSrc}
					alt={identity.profileAlt}
					width="900"
					height="1125"
					loading="lazy"
					decoding="async"
					data-reveal
				/>

				<div class="mt-8 max-w-[35rem] space-y-4 text-base leading-relaxed md:mt-10 md:text-lg" data-reveal>
					<p class="m-0">
						Hay momentos para hablar. Momentos para explicar mejor. Momentos para cambiar el mensaje.
					</p>
					<p class="m-0">Y momentos en los que lo correcto es no decir nada.</p>
					<p class="m-0 border-t border-paper/35 pt-5 font-bold">Eso es comunicación con criterio.</p>
				</div>
			</div>
		</div>
	</div>
</section>
