---
import type { Identity } from '../data/site';
import Brand from './Brand.astro';

interface Props {
	identity: Identity;
}

const { identity } = Astro.props;
---

<header class="sticky top-0 z-50 border-b border-ink/15 bg-brand">
	<div class="page-shell header-bar flex items-center justify-between">
		<a href="/" aria-label="PACHECO, volver al inicio" class="shrink-0 no-underline">
			<Brand identity={identity} />
		</a>

		<a
			href="#contacto"
			data-header-cta
			class="header-cta inline-flex min-h-11 items-center tracking-[0.12em] text-ink uppercase no-underline hover:opacity-70"
		>
			<span class="header-cta__label">Hablemos</span>
		</a>
	</div>
</header>

<script>
	const cta = document.querySelector<HTMLElement>('[data-header-cta]');
	const trigger = document.querySelector<HTMLElement>('[data-header-cta-trigger]');

	if (cta && trigger && 'IntersectionObserver' in window) {
		const observer = new IntersectionObserver(([entry]) => {
			cta.dataset.hidden = String(entry.isIntersecting);
		});

		observer.observe(trigger);
	}
</script>
