---
import type { Identity } from '../data/site';
import Brand from './Brand.astro';

interface Props {
	identity: Identity;
}

const { identity } = Astro.props;
---

<header class="sticky top-0 z-50 border-b border-ink/15 bg-paper/95">
	<div class="page-shell flex min-h-18 items-center justify-between gap-6">
		<a href="#inicio" aria-label="PACHECO, volver al inicio" class="shrink-0 no-underline">
			<Brand identity={identity} />
		</a>

		<a
			href="#contacto"
			class="group inline-flex min-h-11 items-center gap-3 text-sm font-bold uppercase tracking-[0.12em] no-underline"
		>
			Hablemos
			<span class="transition-transform duration-200 ease-out group-hover:translate-x-1" aria-hidden="true">→</span>
		</a>
	</div>
</header>
