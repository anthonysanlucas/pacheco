---
import type { Identity } from '../data/site';
import Brand from './Brand.astro';

interface Props {
	identity: Identity;
}

const { identity } = Astro.props;
---

<header class="sticky top-0 z-50 border-b border-ink/15 bg-brand">
	<div class="page-shell flex min-h-18 items-center justify-between gap-6">
		<a href="#inicio" aria-label="PACHECO, volver al inicio" class="shrink-0 no-underline">
			<Brand identity={identity} />
		</a>

		<a
			href="#contacto"
			class="inline-flex min-h-11 items-center bg-ink px-5 text-sm font-bold tracking-[0.12em] text-brand uppercase no-underline transition-colors duration-200 hover:bg-[#292925]"
		>
			Hablemos
		</a>
	</div>
</header>
