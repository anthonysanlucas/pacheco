---
import testimonials from "../data/testimonials.json";

interface Testimonial {
  id: string;
  name: string;
  role: string;
  quote: string;
  image: string;
}

const items = testimonials as Testimonial[];
const loopGroups = [0, 1, 2];
---

<section
  id="testimonios"
  class="overflow-hidden border-y border-paper/20 bg-graphite py-24 text-paper md:py-32"
>
  <div class="page-shell">
    <h2
      class="m-0 text-[clamp(2.6rem,5.2vw,4.75rem)] leading-[0.88] font-extrabold tracking-[-0.06em] uppercase"
      aria-label="Lo que dicen quienes han trabajo conmigo"
      data-reveal
    >
      <span class="block md:whitespace-nowrap">LO QUE DICEN QUIENES</span>
      <span class="block md:whitespace-nowrap">HAN TRABAJADO CONMIGO.</span>
    </h2>
  </div>

  <div
    class="testimonials-viewport mt-16 md:mt-20"
    data-testimonials-viewport
    tabindex="0"
    aria-label="Testimonios navegables"
  >
    <div class="testimonials-track" data-testimonials-track>
      {
        loopGroups.map((groupIndex) => {
          const isDuplicate = groupIndex > 0;

          return (
            <ul
              class="testimonials-group m-0 list-none p-0"
              role={isDuplicate ? undefined : "list"}
              aria-hidden={isDuplicate ? "true" : undefined}
            >
              {items.map((testimonial) => (
                <li
                  class="testimonial-card flex min-h-[24rem] flex-col border border-paper/35 bg-paper-bright p-7 text-ink md:min-h-[27rem] md:p-9"
                  data-testimonial-id={testimonial.id}
                >
                  <div class="flex min-h-[5.5rem] items-start gap-3 border-b border-ink/20 pb-5 md:min-h-0 md:items-center md:gap-4 md:pb-6">
                    {testimonial.image && (
                      <img
                        src={testimonial.image}
                        width="56"
                        height="56"
                        loading="lazy"
                        alt=""
                        class="size-12 shrink-0 rounded-full object-cover md:size-14"
                      />
                    )}

                    <div class="min-w-0 pt-0.5 md:pt-0">
                      <p class="m-0 text-sm leading-snug font-bold md:text-base md:leading-tight">
                        {testimonial.name}
                      </p>
                      <p class="testimonial-role mt-1 mb-0 text-[0.68rem] leading-snug text-muted md:text-xs">
                        {testimonial.role}
                      </p>
                    </div>
                  </div>

                  <blockquote class="m-0 pt-8 text-sm leading-relaxed font-medium md:text-base">
                    {testimonial.quote}
                  </blockquote>
                </li>
              ))}
            </ul>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  const testimonialsViewport = document.querySelector<HTMLElement>(
    "[data-testimonials-viewport]",
  );
  const testimonialsTrack = document.querySelector<HTMLElement>(
    "[data-testimonials-track]",
  );

  if (testimonialsViewport && testimonialsTrack) {
    const primaryGroup = testimonialsTrack.querySelector<HTMLElement>(
      ".testimonials-group:not([aria-hidden])",
    );
    const duplicateGroup = testimonialsTrack.querySelector<HTMLElement>(
      '.testimonials-group[aria-hidden="true"]',
    );

    const scrollBoost = 1.4;
    let scrollEndTimer: number | undefined;
    let isNormalizing = false;

    const getLoopWidth = () => primaryGroup?.scrollWidth ?? 0;
    const hasLoop = () =>
      Boolean(
        duplicateGroup &&
          getComputedStyle(duplicateGroup).display !== "none" &&
          getLoopWidth() > 0,
      );

    const setLoopStart = () => {
      if (!hasLoop()) return;
      testimonialsViewport.scrollLeft = getLoopWidth();
    };

    const normalizeScroll = () => {
      if (!hasLoop()) return;

      const loopWidth = getLoopWidth();
      const lowerEdge = loopWidth * 0.5;
      const upperEdge = loopWidth * 1.5;

      if (testimonialsViewport.scrollLeft > upperEdge) {
        isNormalizing = true;
        testimonialsViewport.scrollLeft -= loopWidth;
        isNormalizing = false;
      } else if (testimonialsViewport.scrollLeft < lowerEdge) {
        isNormalizing = true;
        testimonialsViewport.scrollLeft += loopWidth;
        isNormalizing = false;
      }
    };

    const markUserScrolling = () => {
      testimonialsViewport.dataset.userScrolling = "true";
      window.clearTimeout(scrollEndTimer);
      scrollEndTimer = window.setTimeout(() => {
        delete testimonialsViewport.dataset.userScrolling;
      }, 500);
    };

    testimonialsViewport.addEventListener("wheel", (event) => {
      const isHorizontalGesture = Math.abs(event.deltaX) > Math.abs(event.deltaY);
      const shouldMoveTestimonials = isHorizontalGesture || event.shiftKey;

      if (!shouldMoveTestimonials) return;

      const dominantDelta = event.shiftKey ? event.deltaY : event.deltaX;

      if (dominantDelta === 0) return;

      event.preventDefault();
      markUserScrolling();

      testimonialsViewport.scrollLeft += dominantDelta * scrollBoost;
      normalizeScroll();
    }, { passive: false });

    testimonialsViewport.addEventListener("scroll", () => {
      if (isNormalizing) return;
      normalizeScroll();
    });

    requestAnimationFrame(setLoopStart);
    window.addEventListener("resize", setLoopStart);
  }
</script>

<style>
  .testimonials-viewport {
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .testimonials-viewport::-webkit-scrollbar {
    display: none;
  }

  .testimonials-viewport:focus-visible {
    outline: 3px solid var(--color-paper);
    outline-offset: 0.5rem;
  }

  .testimonials-track {
    --testimonials-loop-groups: 3;
    display: flex;
    width: max-content;
    animation: testimonials-scroll 60s linear infinite;
    will-change: transform;
  }

  .testimonials-viewport:hover .testimonials-track,
  .testimonials-viewport[data-user-scrolling="true"] .testimonials-track {
    animation-play-state: paused;
  }

  .testimonials-group {
    display: flex;
    gap: 1rem;
    padding-right: 1rem;
  }

  .testimonial-card {
    width: min(82vw, 29rem);
  }

  .testimonial-role {
    display: -webkit-box;
    overflow: hidden;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  @keyframes testimonials-scroll {
    to {
      transform: translateX(calc(-100% / var(--testimonials-loop-groups)));
    }
  }

  @media (min-width: 48rem) {
    .testimonials-group {
      gap: 1.5rem;
      padding-right: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .testimonials-viewport {
      scrollbar-width: none;
    }

    .testimonials-track {
      animation: none;
      will-change: auto;
    }

    .testimonials-group[aria-hidden="true"] {
      display: none;
    }
  }
</style>
