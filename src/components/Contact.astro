---
---

<section id="contacto" class="bg-paper py-32 md:py-40">
  <div class="page-shell">
    <div class="relative">
      <img
        src="/HABLEMOS.png"
        alt="Andrés Pacheco durante una grabación de pódcast frente al micrófono"
        width="2260"
        height="1287"
        class="ml-auto block w-full md:w-[76%]"
        loading="lazy"
        decoding="async"
      />

      <h2
        class="display-contact m-0 mt-8 !text-[clamp(2.5rem,8.4vw,7.5rem)] !leading-[0.9] !tracking-[-0.01em] uppercase md:absolute md:top-1/2 md:left-[8%] md:mt-0 md:-translate-y-1/2"
        aria-label="Hablemos"
        data-reveal
      >
        <span class="block">Ha</span>
        <span class="block">Ble</span>
        <span class="block">Mos</span>
      </h2>
    </div>

    <!-- <footer
			data-header-cta-trigger
			class="mt-32 flex flex-wrap items-end justify-between gap-8 border-t border-ink/35 pt-6 text-xs font-bold tracking-[0.12em] uppercase md:mt-40"
		>
			<p class="m-0">PACHECO — Comunicación con criterio</p>
			<p class="m-0">© {new Date().getFullYear()}</p>
		</footer> -->
  </div>
</section>
