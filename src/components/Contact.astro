---
import ExternalLinkIcon from './icons/ExternalLinkIcon.astro';
import type { ContactDetails } from '../data/site';

interface Props {
	contact: ContactDetails;
}

const { contact } = Astro.props;
---

<section id="contacto" class="min-h-[calc(100dvh-4.5rem)] bg-paper py-24 md:py-32">
	<div class="page-shell flex min-h-[calc(100dvh-16.5rem)] flex-col md:min-h-[calc(100dvh-20.5rem)]">
		<h2 class="display-contact m-0 uppercase" aria-label="Hablemos de lo que estás enfrentando" data-reveal>
			<span class="block">Hablemos</span>
			<span class="block">de lo que estás</span>
			<span class="block">enfrentando.</span>
		</h2>

		{
			(contact.whatsappUrl || contact.email) && (
				<div class="mt-14 grid gap-4 sm:grid-cols-2 md:mt-16 md:max-w-4xl md:gap-6">
					{contact.whatsappUrl && (
						<div>
							<a
								href={contact.whatsappUrl}
								target="_blank"
								rel="noreferrer"
								class="group inline-flex min-h-16 w-full items-center justify-between gap-6 bg-ink px-6 text-sm font-bold tracking-[0.1em] text-white uppercase no-underline transition-colors duration-200 hover:bg-[#292925] md:px-7 md:text-base"
								aria-label="Abrir conversación con PACHECO en WhatsApp"
							>
								<span>Hablemos por WhatsApp</span>
								<ExternalLinkIcon class="shrink-0 transition-transform duration-200 ease-out group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
							</a>
						</div>
					)}

					{contact.email && (
						<div>
							<a
								href={`mailto:${contact.email}`}
								target="_blank"
								rel="noreferrer"
								class="group inline-flex min-h-16 w-full items-center justify-between gap-6 bg-[#dfdcd4] px-6 text-sm font-bold tracking-[0.1em] text-ink uppercase no-underline transition-colors duration-200 hover:bg-[#d3cfc5] md:px-7 md:text-base"
								aria-label="Escribir a PACHECO por correo"
							>
								<span>Escríbenos por correo</span>
								<ExternalLinkIcon class="shrink-0 transition-transform duration-200 ease-out group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
							</a>
						</div>
					)}
				</div>
			)
		}

		<footer class="mt-auto flex flex-wrap items-end justify-between gap-8 border-t border-ink/35 pt-6 text-xs font-bold tracking-[0.12em] uppercase">
			<p class="m-0">PACHECO — Comunicación con criterio</p>
			<p class="m-0">© {new Date().getFullYear()}</p>
		</footer>
	</div>
</section>
