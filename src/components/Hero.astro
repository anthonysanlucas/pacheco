---
// Los banners traen el texto quemado en el frame y pegado a los bordes, asi que
// nunca se recortan: se muestran completos y el sobrante queda en color solido.
const banners = {
	landscape: { video: '/BANNER_16_9.mp4', poster: '/BANNER_16_9.webp' },
	portrait: { video: '/BANNER_9_16.mp4', poster: '/BANNER_9_16.webp' }
};
---

<section id="inicio" class="relative scroll-mt-[var(--header-height)] overflow-hidden bg-[#0e0e0e]">
	<h1 class="sr-only">Estamos haciendo mucho. Pero nadie lo está viendo.</h1>

	<div
		class="relative w-full aspect-[1716/740] phone-portrait:aspect-auto phone-portrait:h-[calc(100svh_-_var(--header-height))]"
	>
		<video
			class="block h-full w-full object-contain"
			data-hero-video
			data-video-landscape={banners.landscape.video}
			data-video-portrait={banners.portrait.video}
			data-poster-landscape={banners.landscape.poster}
			data-poster-portrait={banners.portrait.poster}
			autoplay
			loop
			muted
			playsinline
			preload="metadata"
			aria-hidden="true"></video>
	</div>
</section>

<script>
	const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');

	if (video) {
		// Debe coincidir con el variante `phone-portrait:` del contenedor: solo
		// telefonos en vertical usan el banner 9:16; tablets y escritorio, el ancho.
		const isPortrait = window.matchMedia('(max-aspect-ratio: 3/5)');
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		let onScreen = true;

		const play = () => {
			if (reducedMotion.matches || !onScreen) {
				video.pause();
			} else {
				video.play().catch(() => {});
			}
		};

		// Solo se descarga el banner que corresponde a la orientación actual.
		const sync = () => {
			const portrait = isPortrait.matches;
			const src = portrait ? video.dataset.videoPortrait : video.dataset.videoLandscape;
			const poster = portrait ? video.dataset.posterPortrait : video.dataset.posterLandscape;

			if (poster) video.poster = poster;

			if (src && video.getAttribute('src') !== src) {
				video.src = src;
				video.load();
			}

			play();
		};

		sync();
		isPortrait.addEventListener('change', sync);
		reducedMotion.addEventListener('change', play);

		if ('IntersectionObserver' in window) {
			const observer = new IntersectionObserver(
				([entry]) => {
					onScreen = entry.isIntersecting;
					play();
				},
				{ threshold: 0.05 }
			);

			observer.observe(video);
		}
	}
</script>
