<section
  id="inicio"
  class="relative scroll-mt-18 overflow-hidden bg-ink"
>
  <h1 class="sr-only">Estamos haciendo mucho. Pero nadie lo está viendo.</h1>

  <div class="relative flex min-h-[calc(100svh-4.5rem)] flex-col md:hidden">
    <video
      class="hero-video hero-video--mobile absolute inset-0 h-full w-full scale-125 object-cover opacity-70 blur-2xl brightness-75"
      loop
      muted
      playsinline
      preload="metadata"
      aria-hidden="true"
    >
      <source src="/banner.mp4" type="video/mp4" />
    </video>

    <video
      class="hero-video hero-video--mobile absolute inset-0 z-10 h-full w-full object-contain"
      loop
      muted
      playsinline
      preload="metadata"
      aria-hidden="true"
    >
      <source src="/banner.mp4" type="video/mp4" />
    </video>
  </div>

  <div class="hidden aspect-[1716/740] w-full md:block">
    <video
      class="hero-video hero-video--desktop h-full w-full object-cover"
      loop
      muted
      playsinline
      preload="metadata"
      aria-hidden="true"
    >
      <source src="/banner.mp4" type="video/mp4" />
    </video>
  </div>
</section>

<script>
  const mobileVideos = document.querySelectorAll<HTMLVideoElement>(".hero-video--mobile");
  const desktopVideo = document.querySelector<HTMLVideoElement>(".hero-video--desktop");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const isDesktop = window.matchMedia("(min-width: 768px)");

  const syncVideos = () => {
    const reduce = reducedMotion.matches;
    const desktop = isDesktop.matches;

    mobileVideos.forEach((video) => {
      if (!reduce && !desktop) {
        video.play().catch(() => {});
      } else {
        video.pause();
      }
    });

    if (desktopVideo) {
      if (!reduce && desktop) {
        desktopVideo.play().catch(() => {});
      } else {
        desktopVideo.pause();
      }
    }
  };

  syncVideos();
  reducedMotion.addEventListener("change", syncVideos);
  isDesktop.addEventListener("change", syncVideos);
</script>
