---
import ChevronsDownIcon from "./icons/ChevronsDownIcon.astro";
---

<section
  id="inicio"
  class="page-shell flex min-h-[calc(100svh-4.5rem)] scroll-mt-18 flex-col py-8 md:py-10"
>
  <div class="flex flex-1 items-center py-12 md:py-16">
    <h1
      class="display-hero m-0 min-w-0 max-w-[12ch] text-balance uppercase"
      aria-label="Estamos haciendo mucho. Pero nadie lo está viendo."
      data-reveal
    >
      Estamos<br />haciendo mucho.<br />Pero nadie<br />lo está viendo.
    </h1>
  </div>

  <div
    class="grid gap-7 border-t border-ink/30 pt-6 md:grid-cols-12 md:items-start md:gap-8"
  >
    <p class="m-0 max-w-[39ch] text-lg leading-snug md:col-span-5" data-reveal>
      El problema no es lo que hacemos, sino cómo lo estamos
      mostrando.
    </p>

    <a
      href="#situaciones"
      class="inline-flex min-h-11 items-center gap-3 text-xs font-bold tracking-[0.12em] uppercase no-underline md:col-span-2 md:col-start-11 md:justify-self-end"
    >
      Sigue explorando <ChevronsDownIcon class="hero-next-arrow" size={18} />
    </a>
  </div>
</section>
