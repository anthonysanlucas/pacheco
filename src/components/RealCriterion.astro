---

<section id="criterio-real" class="bg-paper py-24 md:py-32">
	<div class="page-shell">
		<div class="grid gap-y-10 md:grid-cols-12 md:items-center md:gap-x-8">
			<div class="min-w-0 md:col-span-6">
				<h2
					class="display-heading max-w-none !leading-[0.95] text-[clamp(2.5rem,4.4vw,4.5rem)]"
					data-reveal
				>
					<span class="block whitespace-nowrap">El <mark class="box-decoration-clone bg-brand px-1 text-ink">criterio</mark> se</span>
					<mark class="box-decoration-clone block bg-brand px-1 text-[1.3em] text-ink">construye</mark>
					<span class="block whitespace-nowrap text-[0.88em] tracking-normal">en situaciones</span>
					<span class="block text-[1.3em]">reales</span>
				</h2>
			</div>

			<div class="min-w-0 md:col-span-6">
				<img
					class="aspect-[4/3] w-full object-cover object-center"
					src="/CRITERIO.webp"
					alt="Dos trabajadores con casco observando una obra de construcción en altura"
					width="1536"
					height="1147"
					loading="lazy"
					decoding="async"
					data-reveal
				/>
			</div>
		</div>
	</div>
</section>
